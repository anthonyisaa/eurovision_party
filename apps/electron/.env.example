# Electron orchestrator environment.
# Copy this to apps/electron/.env and fill in the blanks before launching.
# Gitignore covers apps/electron/.env — never commit the real file.

# Supabase project URL. Same value as NEXT_PUBLIC_SUPABASE_URL in apps/web/.env.local.
SUPABASE_URL=https://euhwxkwpnskjmngjfqtd.supabase.co

# Service-role key (bypasses RLS). Required so the main process can write
# yt_current_seconds and INSERT chat_messages without a logged-in user.
# Find it at https://supabase.com/dashboard/project/_/settings/api.
SUPABASE_SERVICE_ROLE_KEY=

# The party UUID we're driving. Same value as NEXT_PUBLIC_PARTY_ID.
PARTY_ID=

# YouTube video id to load fullscreen. Just the 11-char id, no URL.
YT_VIDEO_ID=

# Origin of the running Next.js web app. The overlay window loads
# `${WEB_URL}/tv?party=${PARTY_ID}&electron=1`.
WEB_URL=http://localhost:3000
