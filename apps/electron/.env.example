# Electron orchestrator environment.
# Copy this to apps/electron/.env and fill in the blanks before launching.
# Gitignore covers apps/electron/.env — never commit the real file.

# Supabase project URL. Same value as NEXT_PUBLIC_SUPABASE_URL in apps/web/.env.local.
SUPABASE_URL=https://euhwxkwpnskjmngjfqtd.supabase.co

# After the 0008_anon_writes migration the anon key is sufficient for the
# writes this process performs (parties update, scheduled_commentary update via
# RPC, chat_messages insert). Set SUPABASE_SERVICE_ROLE_KEY if you ever revert
# the permissive policies — main.ts prefers it when both are set.
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# The party UUID we're driving. Same value as NEXT_PUBLIC_PARTY_ID.
PARTY_ID=

# YouTube video id to load fullscreen. Just the 11-char id, no URL.
YT_VIDEO_ID=

# Origin of the running Next.js web app. The overlay window loads
# `${WEB_URL}/tv?party=${PARTY_ID}&electron=1`. For day-of, point this at
# https://eurojury.vercel.app so guests on cellular can hit the same backend.
WEB_URL=http://localhost:3000
